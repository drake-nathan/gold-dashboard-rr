{
  "name": "gold-dashboard-rr",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "ci": "bun run scripts/ci.ts",
    "dev": "NODE_OPTIONS='--import ./instrument.server.js' react-router dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "snapshot:export": "bun run scripts/snapshot.ts export",
    "snapshot:import": "bun run scripts/snapshot.ts import",
    "snapshot:sync": "bun run scripts/snapshot.ts sync",
    "start": "NODE_ENV=production NODE_OPTIONS='--import ./instrument.server.js' react-router-serve ./build/server/index.js",
    "test": "vitest run --silent",
    "test:browser": "vitest run --config=vitest.browser.config.ts --silent",
    "test:browser:watch": "vitest --config=vitest.browser.config.ts",
    "test:convex": "vitest run --config=vitest.convex.config.ts --silent",
    "test:convex:watch": "vitest --config=vitest.convex.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:browser": "vitest run --config=vitest.browser.config.ts --coverage",
    "test:watch": "vitest",
    "ts": "tsgo",
    "ts:convex": "tsgo -p convex/tsconfig.json",
    "typegen": "react-router typegen",
    "verify:runtime": "bun run scripts/verify-runtime.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.3.0",
    "@clerk/react-router": "3.0.8",
    "@clerk/ui": "1.3.0",
    "@convex-dev/migrations": "0.3.3",
    "@convex-dev/stripe": "0.1.4",
    "@hookform/resolvers": "5.2.2",
    "@react-router/node": "7.14.0",
    "@react-router/serve": "7.14.0",
    "@sentry/profiling-node": "10.47.0",
    "@sentry/react-router": "10.47.0",
    "babel-plugin-react-compiler": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "convex": "1.34.1",
    "isbot": "5.1.37",
    "lucide-react": "1.7.0",
    "next-themes": "0.4.6",
    "posthog-js": "1.364.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "7.72.1",
    "react-router": "7.14.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "usehooks-ts": "3.1.1",
    "vite-plugin-babel": "1.6.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@react-router/dev": "7.14.0",
    "@tailwindcss/vite": "4.2.2",
    "@types/bun": "1.3.11",
    "@types/node": "24.10.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260404.1",
    "@vitejs/plugin-react": "6.0.1",
    "@vitejs/plugin-rsc": "0.5.21",
    "@vitest/browser-playwright": "4.1.2",
    "@vitest/coverage-v8": "4.1.2",
    "concurrently": "9.2.1",
    "convex-test": "0.0.46",
    "eslint-plugin-perfectionist": "5.8.0",
    "happy-dom": "20.8.9",
    "listr2": "10.2.1",
    "oxfmt": "0.43.0",
    "oxlint": "1.58.0",
    "oxlint-tsgolint": "0.19.0",
    "tailwindcss": "4.2.2",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.2",
    "vite": "8.0.3",
    "vite-plugin-devtools-json": "1.0.0",
    "vitest": "4.1.2",
    "vitest-browser-react": "2.1.0"
  },
  "packageManager": "bun@1.3.8"
}
