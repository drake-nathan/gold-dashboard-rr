# Example environment variables
# Copy to .env.local and fill in your actual values

# Convex (using production deployment only)
CONVEX_DEPLOYMENT=prod:your-deployment-name
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud

# API Keys
UNWRANGLE_API_KEY=
PURE_API_KEY=
GOLD_API_KEY=
FMP_API_KEY=

# Clerk Auth
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=  # Your Clerk domain (e.g., your-app.clerk.accounts.dev)

# Admin Access (comma-separated Clerk user IDs)
ADMIN_USER_IDS=  # e.g., user_2abc123,user_2def456

# Feature Flags
# VITE_ENABLE_AUTH=true  # Uncomment to enable auth UI in production (disabled by default)

# Analytics
VITE_PUBLIC_POSTHOG_KEY=  # PostHog API key (e.g., phc_xxxx)
VITE_PUBLIC_POSTHOG_HOST=  # PostHog host (e.g., https://us.i.posthog.com or https://eu.i.posthog.com)

# Google AdSense (optional - for displaying ads to monetize traffic)
VITE_ADSENSE_CLIENT_ID=  # Google AdSense client ID (e.g., ca-pub-1234567890123456)