{
  "name": "gold-dashboard-rr",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "ci": "bun run scripts/ci.ts",
    "dev": "NODE_OPTIONS='--import ./instrument.server.js' react-router dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "snapshot:export": "bun run scripts/snapshot.ts export",
    "snapshot:import": "bun run scripts/snapshot.ts import",
    "snapshot:sync": "bun run scripts/snapshot.ts sync",
    "start": "NODE_ENV=production NODE_OPTIONS='--import ./instrument.server.js' react-router-serve ./build/server/index.js",
    "test": "vitest run --silent",
    "test:browser": "vitest run --config=vitest.browser.config.ts --silent",
    "test:browser:watch": "vitest --config=vitest.browser.config.ts",
    "test:convex": "vitest run --config=vitest.convex.config.ts --silent",
    "test:convex:watch": "vitest --config=vitest.convex.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:browser": "vitest run --config=vitest.browser.config.ts --coverage",
    "test:watch": "vitest",
    "typecheck": "react-router typegen && tsc",
    "typecheck:convex": "tsc -p convex/tsconfig.json"
  },
  "dependencies": {
    "@clerk/react-router": "3.0.6",
    "@clerk/ui": "1.2.3",
    "@convex-dev/stripe": "0.1.4",
    "@hookform/resolvers": "5.2.2",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tooltip": "1.2.8",
    "@react-router/node": "7.13.1",
    "@react-router/serve": "7.13.1",
    "@sentry/profiling-node": "10.45.0",
    "@sentry/react-router": "10.45.0",
    "babel-plugin-react-compiler": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "convex": "1.34.0",
    "isbot": "5.1.36",
    "lucide-react": "0.577.0",
    "next-themes": "0.4.6",
    "posthog-js": "1.363.1",
    "radix-ui": "1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "7.71.2",
    "react-router": "7.13.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "usehooks-ts": "3.1.1",
    "vite-plugin-babel": "1.6.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@react-router/dev": "7.13.1",
    "@tailwindcss/vite": "4.2.2",
    "@types/bun": "1.3.11",
    "@types/node": "24.10.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitejs/plugin-rsc": "0.5.21",
    "@vitest/browser-playwright": "4.1.0",
    "@vitest/coverage-v8": "4.1.0",
    "concurrently": "9.2.1",
    "convex-test": "0.0.41",
    "eslint-plugin-perfectionist": "5.7.0",
    "happy-dom": "20.8.4",
    "oxfmt": "0.41.0",
    "oxlint": "1.56.0",
    "oxlint-tsgolint": "0.17.1",
    "tailwindcss": "4.2.2",
    "turbo": "2.8.20",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.1",
    "vite-plugin-devtools-json": "1.0.0",
    "vitest": "4.1.0",
    "vitest-browser-react": "2.1.0"
  },
  "packageManager": "bun@1.3.8"
}
