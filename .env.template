# Example environment variables
# Copy to .env.local and fill in your actual values

# Convex (typically dev locally, prod in production)
CONVEX_DEPLOYMENT=dev:your-dev-deployment
VITE_CONVEX_URL=https://your-dev-deployment.convex.cloud

# API Keys
UNWRANGLE_API_KEY=
PURE_API_KEY=
GOLD_API_KEY=
FMP_API_KEY=

# Clerk Auth
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=  # Your Clerk domain (e.g., your-app.clerk.accounts.dev)

# Admin Access (comma-separated Clerk user IDs)
ADMIN_USER_IDS=  # e.g., user_2abc123,user_2def456

# Stripe (for Pro subscriptions)
VITE_STRIPE_ENABLED=  # Set to "true" to enable Stripe subscription UI
STRIPE_SECRET_KEY=  # sk_test_xxx (test) or sk_live_xxx (prod)
STRIPE_WEBHOOK_SECRET=  # whsec_xxx from Stripe dashboard
STRIPE_PRICE_ID=  # price_xxx for the $8/month Pro subscription (server-side)
VITE_STRIPE_PRICE_ID=  # Same price_xxx (client-side, for checkout)
SITE_URL=  # Your site URL for Stripe redirects (e.g., https://dashboard.gold or http://localhost:5173)

# Resend (for alert digest emails)
RESEND_API_KEY=  # re_xxx from Resend dashboard
RESEND_FROM_EMAIL=  # Sender email on verified domain (e.g., alerts@dashboard.gold)
RESEND_REPLY_TO_EMAIL=  # Optional reply-to (defaults to support@dashboard.gold)
UNSUBSCRIBE_SECRET=  # Random string for HMAC signing of unsubscribe links (generate: openssl rand -hex 32)

# Observability
VITE_PUBLIC_POSTHOG_KEY=  # PostHog API key (e.g., phc_xxxx)
VITE_PUBLIC_POSTHOG_HOST=  # PostHog host (e.g., https://us.i.posthog.com or https://eu.i.posthog.com)

# Sentry
VITE_SENTRY_DSN=           # Sentry DSN (public, embedded in client bundle)
SENTRY_AUTH_TOKEN=         # Auth token for source map uploads (build-time only)
SENTRY_ORG=                # Sentry org slug (build-time only)
SENTRY_PROJECT=            # Sentry project slug (build-time only)
VITE_SENTRY_ENVIRONMENT=   # Optional: override environment name (e.g., "preview"). Defaults to NODE_ENV/MODE. Used by both client and server.
