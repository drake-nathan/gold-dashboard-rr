{
  "name": "gold-dashboard-rr",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "ci": "bun run scripts/ci.ts",
    "dev": "react-router dev",
    "format": "prettier . --write --cache --experimental-cli",
    "format:check": "prettier . --check --cache --experimental-cli",
    "lint": "eslint . --cache --concurrency=auto",
    "lint:fix": "bun run lint --fix",
    "start": "react-router-serve ./build/server/index.js",
    "test": "vitest run",
    "test:browser": "vitest run --config=vitest.browser.config.ts",
    "test:browser:watch": "vitest --config=vitest.browser.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:browser": "vitest run --config=vitest.browser.config.ts --coverage",
    "test:watch": "vitest",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@clerk/react-router": "2.3.5",
    "@clerk/themes": "2.4.44",
    "@hookform/resolvers": "5.2.2",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tooltip": "1.2.8",
    "@react-router/node": "7.10.1",
    "@react-router/serve": "7.10.1",
    "babel-plugin-react-compiler": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "convex": "1.31.0",
    "isbot": "5.1.32",
    "lucide-react": "0.561.0",
    "next-themes": "0.4.6",
    "posthog-js": "1.307.1",
    "radix-ui": "1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.68.0",
    "react-router": "7.10.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.4.0",
    "usehooks-ts": "3.1.1",
    "vite-plugin-babel": "1.3.2",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@react-router/dev": "7.10.1",
    "@tailwindcss/vite": "4.1.18",
    "@types/node": "24.10.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "@vitejs/plugin-rsc": "0.5.9",
    "@vitest/browser-playwright": "4.0.16",
    "@vitest/coverage-v8": "4.0.16",
    "concurrently": "9.2.1",
    "happy-dom": "20.0.11",
    "js-style-kit": "0.8.9",
    "tailwindcss": "4.1.18",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.0",
    "vite-plugin-devtools-json": "1.0.0",
    "vite-tsconfig-paths": "6.0.1",
    "vitest": "4.0.16",
    "vitest-browser-react": "2.0.2"
  }
}
