{
  "name": "gold-dashboard-rr",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "ci": "bun run scripts/ci.ts",
    "dev": "react-router dev",
    "format": "prettier . --write --cache",
    "format:check": "prettier . --check --cache",
    "lint": "eslint . --cache --concurrency=auto --max-warnings=0",
    "lint:fix": "bun run lint --fix",
    "snapshot:export": "bun run scripts/snapshot.ts export",
    "snapshot:import": "bun run scripts/snapshot.ts import",
    "snapshot:sync": "bun run scripts/snapshot.ts sync",
    "start": "react-router-serve ./build/server/index.js",
    "test": "vitest run",
    "test:browser": "vitest run --config=vitest.browser.config.ts",
    "test:browser:watch": "vitest --config=vitest.browser.config.ts",
    "test:convex": "vitest run --config=vitest.convex.config.ts",
    "test:convex:watch": "vitest --config=vitest.convex.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:browser": "vitest run --config=vitest.browser.config.ts --coverage",
    "test:watch": "vitest",
    "typecheck": "react-router typegen && tsc",
    "typecheck:convex": "tsc -p convex/tsconfig.json"
  },
  "dependencies": {
    "@clerk/react-router": "2.4.2",
    "@clerk/themes": "2.4.51",
    "@convex-dev/stripe": "0.1.3",
    "@hookform/resolvers": "5.2.2",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tooltip": "1.2.8",
    "@react-router/node": "7.13.0",
    "@react-router/serve": "7.13.0",
    "babel-plugin-react-compiler": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "convex": "1.31.7",
    "isbot": "5.1.34",
    "lucide-react": "0.563.0",
    "next-themes": "0.4.6",
    "posthog-js": "1.339.1",
    "radix-ui": "1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "7.71.1",
    "react-router": "7.13.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.4.0",
    "usehooks-ts": "3.1.1",
    "vite-plugin-babel": "1.4.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@react-router/dev": "7.13.0",
    "@tailwindcss/vite": "4.1.18",
    "@types/bun": "1.3.8",
    "@types/node": "24.10.2",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.3",
    "@vitejs/plugin-rsc": "0.5.18",
    "@vitest/browser-playwright": "4.0.18",
    "@vitest/coverage-v8": "4.0.18",
    "concurrently": "9.2.1",
    "convex-test": "0.0.41",
    "happy-dom": "20.5.0",
    "js-style-kit": "0.8.12",
    "tailwindcss": "4.1.18",
    "turbo": "2.8.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-plugin-devtools-json": "1.0.0",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18",
    "vitest-browser-react": "2.0.5"
  },
  "packageManager": "bun@1.3.8"
}
