{
  "compilerOptions": {
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@/*": ["./app/*"],
      "convex/_generated/*": ["./convex/_generated/*"],
    },
    "resolveJsonModule": true,
    "rootDirs": [".", "./.react-router/types"],
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["bun", "node", "vite/client"],
    "verbatimModuleSyntax": true,
  },
  "exclude": ["convex"],
  "include": [
    "app/**/*",
    "app/**/.server/**/*",
    "app/**/.client/**/*",
    "scripts/**/*",
    ".react-router/types/**/*",
    "*.config.ts",
    "*.config.js",
  ],
}
